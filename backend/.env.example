# JWT
# Gere uma chave forte (>= 32 chars). Obrigatória fora do profile "dev".
JWT_SECRET=

# Admin bootstrap (produção / profiles não-dev)
# Se definidos, a aplicação cria/atualiza um ADMIN no startup.
# Nunca commitar valores reais. Mínimo 12 caracteres para ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth2
# Obtidos no Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend callback após login Google (configurável por ambiente)
# Dev: http://localhost:4200/auth/callback
# Prod: https://seu-dominio/auth/callback  (obrigatório no docker-compose.prod.yml)
OAUTH2_REDIRECT_URI=http://localhost:4200/auth/callback

# Origins permitidas no CORS (lista separada por vírgula)
# Dev: http://localhost:4200
# Prod: https://seu-dominio  (obrigatório no docker-compose.prod.yml)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
