# JWT
# Gere uma chave forte (>= 32 chars). Obrigatória em produção (profiles prod/production).
JWT_SECRET=

# Google OAuth2
# Obtidos no Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend callback após login Google (configurável por ambiente)
OAUTH2_REDIRECT_URI=http://localhost:4200/auth/callback

# Origins permitidas no CORS (lista separada por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379